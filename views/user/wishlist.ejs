<body>
    <% if (typeof toastMessage !=="undefined" ) { %>
        <div id="toast" class="toast <%= toastType %> show">
            <%= toastMessage %>
        </div>
    <% } %>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="/" class="logo">
                <i class="fa-solid fa-bolt text-gradient-clip"></i>
                <span class="text-gradient">Quavix</span>
            </a>

            <div class="mobile-search-container">
                <div class="hamburger-menu">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <form class="mobile-search" action="/products/search" method="GET">
                    <input type="text" name="q" placeholder="Search gadgets...">
                    <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
            </div>

            <!-- Mobile Sidebar (Hidden by default) -->
            <aside class="mobile-sidebar">
                <div class="sidebar-header">
                    <a href="index.html" class="logo">
                        <i class="fa-solid fa-bolt text-gradient-clip"></i>
                        <span class="text-gradient">Quavix</span>
                    </a>
                    <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-content">
                    <a href="/products"><i class="fa-solid fa-shop"></i> Shop</a>
                    <a href="order-history.html"><i class="fa-solid fa-box"></i> Orders</a>
                    <a href="/wishlist" class="relative wishlist-nav">
                        <i class="fa-regular fa-heart"></i> Wishlist
                        <% if (wishlistCount > 0) { %>
                            <span class="badge wishlist-sidebar-badge"><%= wishlistCount %></span>
                        <% } %>
                    </a>
                    <% if (user) { %>
                        <span id="cartSidebarBadge" class="badge cart-sidebar-badge">
                            <%= cartCount || 0 %>
                        </span>
                    <% } %>
                    <% if(user){ %>
                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        <%} else{ %>
                            <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <% } %>
                </div>
            </aside>

            <!-- Overlay -->
            <div class="mobile-overlay"></div>

            <!-- Desktop Menu -->
            <div class="nav-menu">
                <a href="/">Home</a>
                <a href="/products">Shop</a>
                <a href="/order-history">Orders</a>
            </div>

            <div class="nav-icons">
                <!-- Search Bar -->
                <div class="nav-search">
                    <input type="text" placeholder="Search gadgets...">
                    <button><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>

                <a href="/wishlist" class="relative wishlist-nav">
                    <i class="fa-regular fa-heart nav-icon-lg"></i>
                    <% if (wishlistCount > 0) { %>
                        <span class="badge wishlist-badge"><%= wishlistCount %></span>
                        
                    <% } %>
                </a>
                <a href="/cart" class="relative">
                    <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>

                    <% if (user) { %>
                        <span id="cartBadge" class="badge-1 cart-badge">
                            <%= cartCount || 0 %>
                        </span>
                    <% } %>
                </a>
                <% if (user) { %>
                    <a href="/profile" class="nav-profile-icon">

                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" 
                                alt="Profile"
                                class="nav-profile-img">
                        <% } else { %>
                            <div class="nav-default-avatar">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                        <% } %>

                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container py-16">
        <h1 class="mb-4">My Wishlist</h1>

        <% if (wishlist && wishlist.items.length > 0) { %>

        <div class="product-grid wishlist-container">

            <% wishlist.items.forEach(item => { 

                const product = item.product;

                if (!product) return;

                const variant = product.variants.find(v => 
                    v._id.toString() === item.variant.toString()
                ) || product.variants[0];

                const originalPrice = variant.price;
                const offer = Math.max(product.offerPercentage || 0, product.category?.categoryOffer || 0);
                const discount = (originalPrice * offer) / 100;
                const finalPrice = Math.round(originalPrice - discount);

            %>

            <div class="wishlist-item">

                <!-- Image -->
                <div class="wishlist-image-box">
                    <a href="/product/<%= product.slug %>?variant=<%= variant._id %>">
                        <img src="<%= variant.images.primary.url %>" alt="<%= product.name %>">
                    </a>
                </div>
                
                <!-- Info -->
                <div class="wishlist-info">

                    <% 
                        // ===== Extract Attributes Safely =====
                        const attributes = variant.attributes || [];

                        const colorAttr = attributes.find(a => 
                            a.name.toLowerCase().includes("color") ||
                            a.name.toLowerCase().includes("colour")
                        );

                        const ramAttr = attributes.find(a => 
                            a.name.toLowerCase().includes("ram")
                        );

                        const storageAttr = attributes.find(a => 
                            a.name.toLowerCase().includes("rom") ||
                            a.name.toLowerCase().includes("storage")
                        );

                        const color = colorAttr ? colorAttr.value : "";
                        const ram = ramAttr ? ramAttr.value : "";
                        const storage = storageAttr ? storageAttr.value : "";
                    %>

                    <!-- PRODUCT TITLE WITH ATTRIBUTES -->
                    <h2 class="wishlist-title">
                        <%= product.name %>
                        <% if (color || ram || storage) { %>
                            (<%= [color, ram, storage].filter(Boolean).join(", ") %>)
                        <% } %>
                    </h2>

                    <!-- HIGHLIGHTS -->
                    <ul class="wishlist-highlights">

                        <% if (ram || storage) { %>
                            <li><%= [ram, storage].filter(Boolean).join(" | ") %></li>
                        <% } %>

                        <% if (product.highlights && product.highlights.length > 0) { %>
                            <% product.highlights.slice(0,3).forEach(h => { %>
                                <li><%= h %></li>
                            <% }) %>
                        <% } %>

                    </ul>

                </div>

                <!-- Price & Actions -->
                <div class="wishlist-actions">
                    <div class="wishlist-price-block">
                        <span class="price-new">
                            ₹<%= finalPrice.toLocaleString() %>
                        </span>

                        <% if (offer > 0) { %>
                        <div class="flex items-center justify-end gap-2 mt-1">
                            <span class="price-old">
                                ₹<%= originalPrice.toLocaleString() %>
                            </span>
                            <span class="discount-badge">
                                <%= offer %>% OFF
                            </span>
                        </div>
                        <% } %>
                    </div>

                    <div class="wishlist-btn-group">

                        <% if (product.isDeleted || (product.category && product.category.status !== 'Active')) { %>
                            <span class="out-of-stock-label" style="background: #fee2e2; color: #ef4444; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600;">
                                Product Unavailable
                            </span>
                        <% } else if (variant.stock > 0) { %>

                            <button 
                                class="btn btn-primary move-to-cart"
                                data-product="<%= product._id %>"
                                data-variant="<%= variant._id %>">
                                <i class="fa-solid fa-cart-shopping"></i>
                            </button>

                        <% } else { %>

                            <span class="out-of-stock-label">
                                Out of Stock
                            </span>

                        <% } %>

                        <button 
                            class="btn btn-remove"
                            data-product="<%= product._id %>"
                            data-variant="<%= variant._id %>">
                            <i class="fa-solid fa-trash"></i>
                        </button>

                    </div>
                </div>

            </div>

            <% }) %>

        </div>

        <% } else { %>

            <p class="text-muted text-center">
                Your wishlist is empty.
            </p>

        <% } %>
    </div>

    <script src="/js/user/wishlist.js"></script>
    
    

</body>

