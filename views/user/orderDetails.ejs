<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<body class="order-details-page">
    <div id="admin-spinner" class="spinner-overlay" style="display:none;">
        <div class="spinner"></div>
    </div>
    <% if (typeof toastMessage !=="undefined" ) { %>
        <% if (toastType==="error" ) { %>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    Swal.fire({
                        icon: "error",
                        title: "Action Restricted",
                        text: "<%= toastMessage %>",
                        confirmButtonColor: "#6366f1"
                    })
                })
            </script>
            <% } else { %>
                <div id="toast" class="toast <%= toastType %>">
                    <%= toastMessage %>
                </div>
                <% } %>
                    <% } %>

                        <!-- Navbar -->
                        <nav class="navbar">
                            <div class="container nav-container">
                                <a href="/" class="logo">
                                    <i class="fa-solid fa-bolt text-gradient-clip"></i>
                                    <span class="text-gradient">Quavix</span>
                                </a>

                                <!-- Mobile Menu Elements (from standard template) -->
                                <div class="mobile-search-container">
                                    <div class="hamburger-menu">
                                        <i class="fa-solid fa-bars"></i>
                                    </div>
                                    <form class="mobile-search" action="/products/search" method="GET">
                    <input type="text" name="q" placeholder="Search gadgets...">
                    <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
                                </div>

                                <aside class="mobile-sidebar">
                                    <div class="sidebar-header">
                                        <a href="/" class="logo">
                                            <i class="fa-solid fa-bolt text-gradient-clip"></i>
                                            <span class="text-gradient">Quavix</span>
                                        </a>
                                        <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                                    </div>
                                    <div class="sidebar-content">
                                        <a href="/products"><i class="fa-solid fa-shop"></i> Shop</a>
                                        <a href="/order-history" class="text-primary"><i
                                                class="fa-solid fa-box text-primary"></i>Orders</a>
                                        <a href="/wishlist" class="relative wishlist-nav">
                                            <i class="fa-regular fa-heart"></i> Wishlist
                                            <% if (wishlistCount> 0) { %>
                                                <span class="badge wishlist-sidebar-badge">
                                                    <%= wishlistCount %>
                                                </span>
                                                <% } %>
                                        </a>
                                        <a href="/cart" class="relative">
                                            <i class="fa-solid fa-cart-shopping"></i> Cart

                                            <% if (cartCount> 0) { %>
                                                <span class="badge cart-sidebar-badge">
                                                    <%= cartCount %>
                                                </span>
                                                <% } %>

                                        </a>
                                        <% if (user) { %>
                                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                                            <% } else { %>
                                                <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign
                                                    In</a>
                                                <% } %>
                                    </div>
                                </aside>

                                <div class="mobile-overlay"></div>

                                <!-- Desktop Menu -->
                                <div class="nav-menu">
                                    <a href="/">Home</a>
                                    <a href="/products">Shop</a>
                                    <a href="/order-history" class="text-primary">Orders</a>
                                </div>

                                <div class="nav-icons">
                                    <form class="nav-search" action="/products/search" method="GET">
                                        <input type="text" name="q" placeholder="Search gadgets...">
                                        <button type="submit">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </button>
                                    </form>

                                    <a href="/wishlist" class="relative wishlist-nav">
                                        <i class="fa-regular fa-heart nav-icon-lg"></i>
                                        <% if (wishlistCount> 0) { %>
                                            <span class="badge wishlist-badge">
                                                <%= wishlistCount %>
                                            </span>

                                            <% } %>
                                    </a>
                                    <a href="/cart" class="relative">
                                        <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>

                                        <% if (cartCount> 0) { %>
                                            <span class="badge cart-badge">
                                                <%= cartCount %>
                                            </span>
                                            <% } %>
                                    </a>
                                    <% if (user) { %>
                                        <a href="/profile" class="nav-profile-icon">

                                            <% if (user.profileImage) { %>
                                                <img src="<%= user.profileImage %>" alt="Profile"
                                                    class="nav-profile-img">
                                                <% } else { %>
                                                    <div class="nav-default-avatar">
                                                        <%= user.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <% } %>

                                        </a>
                                        <% } else { %>
                                            <a href="/login" class="btn btn-primary btn-sm">
                                                <i class="fa-solid fa-right-to-bracket"></i> Sign In
                                            </a>
                                            <% } %>
                                </div>
                            </div>
                        </nav>


                        <div class="container order-details-py">


                            <!-- Breadcrumb & Title -->
                            <div class="mb-6 flex justify-between items-end flex-wrap gap-4">
                                <div>
                                    <a href="/order-history"
                                        class="text-sm text-muted hover-action inline-flex items-center gap-2 mb-2">
                                        <i class="fa-solid fa-arrow-left"></i> Back to Orders
                                    </a>
                                    <h1 class="text-2xl font-bold">Order Details</h1>
                                </div>
                                <% const status=item.orderStatus; let returnAllowed=false; if(status==="delivered" &&
                                    item.deliveredAt){ const days=(Date.now() - new Date(item.deliveredAt)) / (1000 * 60
                                    * 60 * 24); if(days <=7){ returnAllowed=true; } } %>

                                    <div class="mb-1 flex items-center gap-6">

                                        <% if( status !=="cancelled" && status !=="returned" && status
                                            !=="return_Request" && status !=="return_rejected" ){ %>

                                            <% if(status==="delivered" ){ %>

                                                <% if(returnAllowed){ %>

                                                    <!-- RETURN ORDER -->
                                                    <a href="#"
                                                        class="text-sm font-medium text-primary hover:underline flex items-center gap-2"
                                                        onclick="toggleModal(true); return false;"><i
                                                            class="fa-solid fa-circle-question opacity-80"></i> Return
                                                        Item</a>

                                                    <% } %>

                                                <% } else { %>

                                                        <!-- CANCEL ORDER -->
                                                    <a href="#"
                                                        class="text-sm font-medium text-primary hover:underline flex items-center gap-2"
                                                        onclick="toggleModal(true); return false;"><i
                                                            class="fa-solid fa-circle-question opacity-80"></i>
                                                        Cancel Item</a>

                                                    <% } %>

                                                <% } %>


                                                <!-- Divider -->
                                                <% if(status==="delivered" ){ %>
                                                    <div class="h-4 w-px bg-slate-200"></div>

                                                    <!-- INVOICE -->
                                                    <a href="#"
                                                        class="text-sm font-medium text-primary hover:underline flex items-center gap-2"
                                                        onclick="downloadInvoice('<%= order.orderId %>', '<%= item.variantId %>'); return false;"
                                                        title="Download Invoice">
                                                        <i
                                                            class="fa-solid fa-file-arrow-down opacity-80"></i>
                                                        Download Invoice
                                                    </a>
                                             <% } %>

                                    </div>
                            </div>

                            <!-- Order Status Banner -->
                            <div class="order-status-banner">
                                <div>
                                    <p class="text-xs text-muted font-medium tracking-wider">Order ID</p>
                                    <p class="font-bold">
                                        <%= order.orderId %>
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs text-muted font-medium tracking-wider">Date Placed</p>
                                    <p class="font-bold text-main">
                                        <%= new Date(order.createdAt).toLocaleDateString("en-IN", { day: "numeric"
                                            ,month: "long" ,year: "numeric" }) %>
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs text-muted font-medium tracking-wider">Status</p>

                                    <div
                                        class="status-badge badge-<%= item.orderStatus.toLowerCase().replaceAll('_','-') %>">
                                        <i class="fa-solid fa-circle-check"></i>
                                        <%= item.orderStatus.replaceAll("_"," ").replace(/\b\w/g, l => l.toUpperCase()) %>
            </div>

            </div>
        </div>
        <% if(status === "return_Request"){ %>


            <p class="text-sm font-medium text-yellow-700" style="color: red;">
                Your return request has been submitted and is waiting for admin
                approval.
            </p>

            <% } %>

                <% if(status==="return_rejected" ){ %>


                    <p class="text-sm font-medium text-red-600" style="color: #6041E8;">
                        Your return request was rejected by admin.
                    </p>
                    <p class="text-sm text-red-600 mt-1">
                        Reason: <%= item.returnRejectReason || "No reason provided" %>
                    </p>


            <% } %>

        <!-- Main Combined Layout -->
        <div class="order-combined-layout">

            <!-- Left Col: Main Content (Products & Info) -->
            <div class="main-content-column">

                <!-- Products Section -->
                <div class="flex flex-col gap-2">
                    <!-- Product -->
                    <div class="product-item-card">

                        <div class="product-img-wrap">
                            <img src="<%= item.productImage %>"
                                alt="<%= item.productName%>">
                        </div>

                        <div
                            class="flex-grow flex flex-col justify-between min-h-80">

                            <div>

                                <div
                                    class="flex justify-between items-start mb-1 flex-wrap gap-2">

                                    <h3
                                        class="font-bold text-lg text-main">
                                        <%= item.productName %>
                                    </h3>

                                    <% let
                                        itemPriceAfterCoupon=item.price;
                                        if(order.couponDiscount &&
                                        order.subtotal> 0){

                                        const itemShare = item.total /
                                        order.subtotal
                                        const couponShare =
                                        order.couponDiscount * itemShare

                                        const perUnitCoupon =
                                        couponShare / item.quantity

                                        itemPriceAfterCoupon =
                                        Math.round(item.price -
                                        perUnitCoupon)
                                        }
                                        %>

                                        <p
                                            class="font-bold text-lg text-primary">
                                            ₹<%= itemPriceAfterCoupon.toLocaleString("en-IN")
                                                %>
                                        </p>

                                </div>

                                <div
                                    class="text-sm text-muted flex flex-col gap-1 mt-2">

                                    <% item.attributes.forEach(attr=> {
                                        %>
                                        <span>
                                            <strong>
                                                <%= attr.name %>:
                                            </strong>
                                            <%= attr.value %>
                                        </span>
                                        <% }) %>

                                            <span
                                                class="font-medium mt-1">
                                                Qty: <%= item.quantity
                                                    %>
                                            </span>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <!-- Shipping & Payment Bottom Grid -->
                <div class="order-info-bottom-grid">
                    <!-- Shipping Details -->
                    <div class="card p-6">
                        <h3
                            class="font-bold text-lg mb-4 flex items-center gap-2">
                            <i
                                class="fa-solid fa-location-dot text-primary"></i>
                            Shipping Address
                        </h3>
                        <div class="text-sm address-details-text">
                            <p
                                class="font-bold mb-1 text-main address-name">
                                <%= order.shippingAddress?.fullname
                                    || "N/A" %>
                            </p>

                            <p>
                                <%= order.shippingAddress?.street || ""
                                    %>
                            </p>

                            <p>
                                <%= order.shippingAddress?.city || "" %>
                                    - <%= order.shippingAddress?.pincode
                                        || "" %>
                            </p>

                            <p>
                                <%= order.shippingAddress?.state || ""
                                    %>
                            </p>

                            <p class="mt-3 text-primary font-medium"><i
                                    class="fa-solid fa-phone text-muted phone-icon-sm"></i>
                                <%= order.shippingAddress?.phone || ""
                                    %>
                            </p>

                        </div>
                    </div>

                    <!-- Payment Summary -->
                    <div class="card p-6">

                        <div
                            class="flex justify-between items-center mb-6">

                            <h3
                                class="font-bold text-lg flex items-center gap-2">
                                <i
                                    class="fa-solid fa-receipt text-primary"></i>
                                Payment Summary
                            </h3>

                            <% const payStatus=item.paymentStatus
                                || "pending" %>

                                <% if(order.paymentMethod !=="cod" ||
                                    payStatus==="refunded" ){ %>

                                    <span
                                        class="pay-status-badge pay-status-<%= payStatus %>">
                                        <%= payStatus.toUpperCase() %>
                                    </span>

                                    <% } %>

                        </div>


                        <div class="text-sm">

                            <div class="flex flex-col gap-3 mb-6">

                                <div class="flex justify-between">
                                    <span
                                        class="text-slate-500">Method</span>

                                    <span class="font-bold text-main">
                                        <%= order.paymentMethod.toUpperCase()
                                            %>
                                    </span>
                                </div>


                                <div class="flex justify-between">
                                    <span class="text-slate-500">Items
                                        Total</span>

                                    <span class="font-medium text-main">
                                        ₹<%= item.total.toLocaleString()
                                            %>
                                    </span>
                                </div>


                                <% if(itemDiscount && itemDiscount> 0){
                                    %>

                                    <div class="flex justify-between">
                                        <span
                                            class="text-slate-500">Coupon
                                            Discount</span>

                                        <span
                                            class="text-green-600 font-medium">
                                            - ₹<%=
                                                Math.round(itemDiscount).toLocaleString()
                                                %>
                                        </span>
                                    </div>

                                    <% } %>


                                        <div
                                            class="flex justify-between">
                                            <span
                                                class="text-slate-500">Shipping</span>

                                            <span
                                                class="font-medium text-main">
                                                ₹<%= 0 %>
                                            </span>
                                        </div>


                                        <div
                                            class="flex justify-between items-center font-bold text-main mt-4 border-t pt-4">

                                            <span>Total Amount</span>

                                            <span class="text-primary">
                                                ₹<%= finalItemTotal.toLocaleString()
                                                    %>
                                            </span>

                                        </div>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

            <% const
                steps=["placed","pending","shipped","out_for_delivery","delivered"];
                const currentStatus=item.orderStatus?.toLowerCase();
                const currentIndex=steps.indexOf(currentStatus); let
                progressClass="" ; if(currentStatus==="pending" )
                progressClass="progress-h-25" ;
                if(currentStatus==="shipped" )
                progressClass="progress-h-50" ;
                if(currentStatus==="out_for_delivery" )
                progressClass="progress-h-75" ;
                if(currentStatus==="delivered" )
                progressClass="progress-h-100" ;
                if(currentStatus==="returned" ||
                currentStatus==="cancelled" )
                progressClass="progress-h-100" ;
                if(currentStatus==="return_request" )
                progressClass="progress-h-100" ;
                if(currentStatus==="return_rejected" )
                progressClass="progress-h-100" ; %>

                <!-- Right Col: Vertical Stepper -->
                <aside>

                    <div
                        class="order-tracking-stepper-vertical <%= currentStatus === 'returned' ? 'has-returned' : '' %> <%= currentStatus === 'cancelled' ? 'has-returned' : '' %>">

                        <div class="stepper-line">
                            <div
                                class="stepper-progress-bar <%= progressClass %>">
                            </div>
                        </div>


                        <!-- PLACED -->
                        <div
                            class="step-item <%= currentIndex >= 0 ? 'completed' : '' %> <%= currentIndex === 0 ? 'active' : '' %>">

                            <div class="step-icon">
                                <i class="fa-solid fa-box"></i>
                            </div>

                            <div class="step-info">
                                <p class="step-label">Placed</p>
                            </div>

                        </div>


                        <!-- PENDING -->
                        <div
                            class="step-item <%= currentIndex >= 1 ? 'completed' : '' %> <%= currentIndex === 1 ? 'active' : '' %>">

                            <div class="step-icon">
                                <i class="fa-solid fa-clock"></i>
                            </div>

                            <div class="step-info">
                                <p class="step-label">Pending</p>
                            </div>

                        </div>


                        <!-- SHIPPED -->
                        <div
                            class="step-item <%= currentIndex >= 2 ? 'completed' : '' %> <%= currentIndex === 2 ? 'active' : '' %>">

                            <div class="step-icon">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>

                            <div class="step-info">
                                <p class="step-label">Shipped</p>
                            </div>

                        </div>


                        <!-- OUT FOR DELIVERY -->
                        <div
                            class="step-item <%= currentIndex >= 3 ? 'completed' : '' %> <%= currentIndex === 3 ? 'active' : '' %>">

                            <div class="step-icon">
                                <i class="fa-solid fa-motorcycle"></i>
                            </div>

                            <div class="step-info">
                                <p class="step-label">Out for Delivery
                                </p>
                            </div>

                        </div>


                        <!-- DELIVERED -->
                        <div
                            class="step-item <%= currentIndex >= 4 ? 'completed' : '' %> <%= currentIndex === 4 ? 'active' : '' %>">

                            <div class="step-icon">
                                <i class="fa-solid fa-house"></i>
                            </div>

                            <div class="step-info">
                                <p class="step-label">Delivered</p>
                            </div>

                        </div>

                        <% if(currentStatus==="return_request" ){ %>

                            <div
                                class="step-item completed active returned-step">

                                <div class="step-icon">
                                    <i
                                        class="fa-solid fa-arrow-rotate-left"></i>
                                </div>

                                <div class="step-info">
                                    <p class="step-label">Return
                                        Requested</p>
                                </div>

                            </div>

                            <% } %>

                                <% if(currentStatus==="return_rejected"
                                    ){ %>

                                    <div
                                        class="step-item completed active return-rejected-step">

                                        <div class="step-icon">
                                            <i
                                                class="fa-solid fa-circle-xmark"></i>
                                        </div>

                                        <div class="step-info">
                                            <p class="step-label">Return
                                                Rejected</p>
                                        </div>

                                    </div>

                            <% } %>


                            <!-- RETURNED -->
                            <% if(currentStatus==="returned"
                                ){ %>

                                <div
                                    class="step-item completed active returned-step">

                                    <div class="step-icon">
                                        <i
                                            class="fa-solid fa-arrow-rotate-left"></i>
                                    </div>

                                    <div class="step-info">
                                        <p
                                            class="step-label">
                                            Returned</p>
                                    </div>

                                </div>

                                <% } %>


                                <!-- CANCELLED -->
                                <% if(currentStatus==="cancelled"
                                    ){ %>

                                    <div
                                        class="step-item completed active returned-step">

                                        <div
                                            class="step-icon">
                                            <i
                                                class="fa-solid fa-ban"></i>
                                        </div>

                                        <div
                                            class="step-info">
                                            <p
                                                class="step-label">
                                                Cancelled
                                            </p>
                                        </div>

                                    </div>

                                    <% } %>

                    </div>

                </aside>
        </div>
    </div>

    <!-- Help & Support Modal -->
    <div class="modal-overlay" id="helpModalOverlay">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Request Help</h3>
                <button class="modal-close" id="closeHelpModal"
                    onclick="toggleModal(false)"><i
                        class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">


                <div class="mb-6">
                    <p class="text-sm font-bold text-main mb-2">
                        Request Type:
                        <span class="text-primary">
                            <%= status==="delivered" ? "Return Order" : "Cancel Order" %>
                        </span>
                    </p>
                </div>

                <form id="form" method="post" action="/order-request">
                    <input type="hidden" name="orderId" value="<%= order.orderId %>">

                    <!-- Product Selection (Only for Return) -->
                    <div id="productSelectionSection" class="mb-6">
                        <label class="font-bold block text-sm mb-3">Item</label>


                        <div class="modal-product-list">

                            <div class="modal-product-card">

                                <div class="modal-product-info">

                                    <!-- Product Image -->
                                    <div class="modal-product-img">
                                        <img src="<%= item.productImage %>"
                                            alt="<%= item.productName %>">
                                    </div>

                                    <!-- Product Details -->
                                    <div class="modal-product-details">

                                        <p class="modal-product-name">
                                            <%= item.productName %>
                                        </p>

                                        <p class="modal-product-meta text-xs">

                                            <% if(item.attributes &&
                                                item.attributes.length){ %>

                                                <% item.attributes.forEach((attr,
                                                    index)=> { %>

                                                    <%= attr.value %>
                                                        <%= index <
                                                        item.attributes.length - 1
                                                        ? " | " : "" %>

                                                     <% }) %>

                                                <% } %>

                                        </p>

                                    </div>

                                </div>

                                <!-- Quantity Selector (only if ordered quantity > 1) -->
                                <input type="hidden" name="variantId" value="<%= item.variantId %>">
                            </div>

                        </div>
                    </div>

                    <!-- Select Reason -->
                    <div class="mb-6">
                        <label class="font-bold block text-sm mb-3">Reason for
                            Request</label>
                        <select name="reason" id="reason"
                            class="form-input-refined appearance-auto">
                            <option value="" selected disabled>Select a reason</option>
                            <option value="mind_change">Changed my mind</option>
                            <option value="price_drop">Found a better price elsewhere
                            </option>
                            <option value="defective">Item is defective or damaged
                            </option>
                            <option value="wrong_item">Received wrong item</option>
                            <option value="others">Others</option>
                        </select>
                        <small class="error-message"></small>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label class="font-bold block text-sm mb-3">Details</label>
                        <textarea name="description" id="description"
                            class="form-input-refined" rows="4"
                            placeholder="Please describe the issue in detail..."></textarea>
                        <small class="error-message"></small>

                    </div>


                    <div class="modal-footer">
                        <button class="btn btn-shopping" id="cancelModalBtn"
                            onclick="toggleModal(false)">Cancel</button>
                        <button type="submit" form="form" class="btn btn-primary">Submit
                            Request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/user/navbar.js"></script>
    <script src="/js/user/orderDetails.js"></script>



</body>