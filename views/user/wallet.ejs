<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;700;800&display=swap" rel="stylesheet">

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-fixed">
        <div class="container nav-container">
            <a href="/" class="logo">
                <i class="fa-solid fa-bolt text-gradient-clip"></i>
                <span class="text-gradient">Quavix</span>
            </a>

            <div class="mobile-search-container">
                <div class="hamburger-menu">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <form class="mobile-search" action="/products/search" method="GET">
                    <input type="text" name="q" placeholder="Search gadgets...">
                    <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
            </div>

            <!-- Mobile Sidebar (Hidden by default) -->
            <aside class="mobile-sidebar">
                <div class="sidebar-header">
                    <a href="/" class="logo">
                        <i class="fa-solid fa-bolt text-gradient-clip"></i>
                        <span class="text-gradient">Quavix</span>
                    </a>
                    <button class="close-btn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="sidebar-content">
                    <a href="/products"><i class="fa-solid fa-shop"></i> Shop</a>
                    <a href="/order-history"><i class="fa-solid fa-box"></i> Orders</a>
                    <a href="/wishlist" class="relative wishlist-nav">
                        <i class="fa-regular fa-heart"></i> Wishlist
                        <% if (wishlistCount > 0) { %>
                            <span class="badge wishlist-sidebar-badge"><%= wishlistCount %></span>
                        <% } %>
                    </a>
                    <a href="/cart" class="relative">
                        <i class="fa-solid fa-cart-shopping"></i> Cart

                        <% if (cartCount > 0) { %>
                            <span class="badge cart-sidebar-badge"><%= cartCount %></span>
                        <% } %>

                    </a>

                    <% if (user) { %>
                            <a href="/profile"><i class="fa-solid fa-user"></i> Profile</a>
                            <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                        <% } else { %>
                            <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                    <% } %>
                </div>
            </aside>

            <!-- Overlay -->
            <div class="mobile-overlay"></div>

            <!-- Desktop Menu -->
            <div class="nav-menu">
                <a href="/">Home</a>
                <a href="/products">Shop</a>
                <a href="/order-history">Orders</a>
            </div>

            <div class="nav-icons">
                <!-- Search Bar -->
                <form class="nav-search" action="/products/search" method="GET">
                    <input type="text" name="q" placeholder="Search gadgets...">
                    <button type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </form>

                <a href="/wishlist" class="relative wishlist-nav">
                    <i class="fa-regular fa-heart nav-icon-lg"></i>
                    <% if (wishlistCount > 0) { %>
                        <span class="badge wishlist-badge"><%= wishlistCount %></span>
                        
                    <% } %>
                </a>

                <a href="/cart" class="relative">
                    <i class="fa-solid fa-cart-shopping nav-icon-lg"></i>

                    <% if (cartCount > 0) { %>
                        <span class="badge cart-badge"><%= cartCount %></span>
                    <% } %>
                </a>

                <% if (user) { %>
                    <a href="/profile" class="nav-profile-icon">

                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage %>" 
                                alt="Profile"
                                class="nav-profile-img">
                        <% } else { %>
                            <div class="nav-default-avatar">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                        <% } %>

                    </a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Profile Section -->
    <section class="section-padding section-profile">
        <div class="container">
            <h2 class="mb-8">My Profile</h2>

            <div class="grid gap-8 profile-grid">
                <!-- Profile Sidebar / Card -->
                <div class="card p-6">
                    <div class="text-center mb-6">
    
                        <div class="profile-img-container">
                            <% if (user.profileImage) { %>
                                <img src="<%= user.profileImage %>" alt="Profile" class="profile-img">
                            <% } else { %>
                                <div class="default-avatar">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                            <% } %>
                        </div>
                        

                        <h3 class="text-xl font-bold"><%= user.name %></h3>
                        <p class="text-muted"><%= user.email %></p>

                    </div>
                    <br>
                    <div class="flex flex-col">
                        <a href="/profile" class="profile-nav-link">
                            <i class="fa-solid fa-user"></i> Personal Details
                        </a>
                        <a href="/order-history" class="profile-nav-link">
                            <i class="fa-solid fa-box"></i> My Orders
                        </a>
                        <a href="/cart" class="profile-nav-link">
                            <i class="fa-solid fa-cart-shopping"></i> My Cart
                        </a>
                        <a href="/wishlist" class="profile-nav-link">
                            <i class="fa-regular fa-heart"></i> My Wishlist
                        </a>
                        <a href="/coupons" class="profile-nav-link">
                            <i class="fa-solid fa-ticket"></i> My Coupons
                        </a>
                        <a href="/wallet" class="profile-nav-link active">
                            <i class="fa-solid fa-wallet"></i> My Wallet
                        </a>
                        <a href="/referral" class="profile-nav-link">
                            <i class="fa-solid fa-share-nodes"></i> Refer & Earn
                        </a>
                        <a href="/logout" class="btn btn-outline-danger w-full mt-4 text-left">
                            <i class="fa-solid fa-right-from-bracket mr-2"></i> Logout
                        </a>
                    </div>
                </div>

                <!-- Wallet Content -->
                <div class="flex flex-col gap-8">

                    <!-- Wallet Balance Card -->
                    <div class="wallet-balance-card p-8">
                        <div>
                            <p class="text-white-muted mb-2">Total Balance</p>
                            <h2 class="text-4xl font-bold text-white mb-0">
                                ₹<%= wallet ? wallet.balance.toLocaleString("en-IN", {minimumFractionDigits: 2}) : "0.00" %>
                            </h2>
                        </div>
                        <button id="reloadBtn" class="btn-reload" title="Reload Balance">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </div>

                    <div class="card p-8">
                        <h3 class="text-xl font-bold mb-6">Transactions</h3>
                        <br>

                        <div class="transaction-list-header">
                            <div>Date</div>
                            <div>Description</div>
                            <div>Status</div>
                            <div class="text-right">Amount</div>
                        </div>

                        <div class="transaction-list" id="walletTransactions">

                            <% if (wallet && wallet.transactions.length > 0) { %>

                                <% wallet.transactions.slice().reverse().forEach(transaction => { %>

                                    <div class="transaction-item">

                                        <!-- Date -->
                                        <div class="transaction-date">
                                            <%= new Date(transaction.date).toLocaleDateString("en-GB", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric"
                                            }) %>
                                        </div>

                                        <!-- Description -->
                                        <div class="transaction-desc">
                                            <%= transaction.description %>
                                        </div>

                                        <!-- Status -->
                                        <div class="transaction-status">

                                            <% if (transaction.type === "credit") { %>

                                                <span class="status-badge-inline badge-credit">
                                                    Credit
                                                </span>

                                            <% } else { %>

                                                <span class="status-badge-inline badge-debit">
                                                    Debit
                                                </span>

                                            <% } %>

                                        </div>

                                        <!-- Amount -->
                                        <div class="transaction-amount 
                                            <%= transaction.type === 'credit' ? 'text-green' : 'text-red' %>">

                                            <span class="mobile-label">Amount</span>

                                            <span class="amount-value">
                                                ₹<%= transaction.amount.toLocaleString("en-IN",{minimumFractionDigits:2}) %>
                                            </span>

                                        </div>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <p class="text-muted text-center">No transactions yet.</p>

                            <% } %>

                        </div>
                    </div>

                    <!-- Pagination -->
                    <div class="pagination">

                        <% if(currentPage > 1){ %>
                            <a href="#" class="page-link" data-page="<%= currentPage - 1 %>">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        <% } %>

                        <% for(let i = 1; i <= totalPages; i++){ %>
                            <a href="#" class="page-link <%= currentPage === i ? 'active' : '' %>" data-page="<%= i %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if(currentPage < totalPages){ %>
                            <a href="#" class="page-link" data-page="<%= currentPage + 1 %>">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        <% } %>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <script>

        document.querySelectorAll(".page-link").forEach(btn => {

            btn.addEventListener("click", async function(e){

                e.preventDefault()

                const page = this.dataset.page

                const res = await fetch(`/wallet?page=${page}`)
                const html = await res.text()

                const newDoc = new DOMParser().parseFromString(html, "text/html")

                const newContent = newDoc.querySelector("#walletContent").innerHTML

                document.querySelector("#walletContent").innerHTML = newContent

            })

        })

        document.getElementById("reloadBtn").addEventListener("click", function(){

            location.reload()

        })

    </script>

</body>

